# MiniMax API Key：服务端必填，仅由部署者填写。
MINIMAX_API_KEY=
# MiniMax GroupId：服务端可选；新版平台通常留空。
MINIMAX_GROUP_ID=
# MiniMax voice_id：服务端必填，仅由部署者填写。
MINIMAX_VOICE_ID=
# MiniMax 模型：服务端必填，仅由部署者填写。
MINIMAX_MODEL=
# 公开访问令牌：loopback 可留空；非 loopback 必须不少于 32 字符且不得含空白。
# 配置后 POST /api/tts 必须使用 Authorization: Bearer <token>。不要提交真实值。
PUBLIC_V1_ACCESS_TOKEN=
# ChatGPT 私有 MCP 连接：三项必须同时配置；不使用时全部留空。
# 公开 origin 必须是精确 HTTPS origin，不带路径、端口或结尾斜杠。
AURALIS_PUBLIC_ORIGIN=
# 8 至 128 个无空白字符；这是公开客户端标识，不是密钥。
AURALIS_OAUTH_CLIENT_ID=
# 至少 32 个无空白字符；只放在服务端环境与 ChatGPT 私有连接设置中。
AURALIS_OAUTH_CLIENT_SECRET=
# 从 ChatGPT “Add custom MCP server”高级设置复制的本次连接专属 Callback URL。
AURALIS_OAUTH_REDIRECT_URI=
